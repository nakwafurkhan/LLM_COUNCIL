# ---------------------------------------------------------------------------
# Mesh API  (https://meshapi.ai)  — REQUIRED
# ---------------------------------------------------------------------------
# Mesh is OpenAI-compatible, so this app only needs a base URL and a key.
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# ---------------------------------------------------------------------------
# The council
# ---------------------------------------------------------------------------
# Comma-separated. Keep it to 3 unless you want to pay for more:
# a full run costs roughly (2 x members) + 1 completions.
COUNCIL_MODELS=openai/gpt-4o,anthropic/claude-sonnet-4.5,google/gemini-2.5-pro
CHAIRMAN_MODEL=anthropic/claude-sonnet-4.5

# Stand-in used when a council member errors or times out.
FALLBACK_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Spend guards
# ---------------------------------------------------------------------------
MAX_TOKENS_STAGE1=1200
MAX_TOKENS_STAGE2=800
MAX_TOKENS_STAGE3=2000
MAX_TOKENS_CODE=4000
TEMPERATURE=0.7
REQUEST_TIMEOUT_S=120
MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Code + PR mode (optional) — needs a token with `repo` scope
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8001
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
