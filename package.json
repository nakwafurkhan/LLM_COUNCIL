{
  "name": "llm-council",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-model LLM council with Chat, Quick, Council and Code+PR modes",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test:unit && npm run test:integration && npm run test:client",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:client": "vitest run --project client",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
