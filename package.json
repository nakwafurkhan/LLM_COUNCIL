{
  "name": "llm-council",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-model deliberation client for the Mesh API gateway. MERN.",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "node --watch server/src/index.js",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "node server/src/index.js",
    "test": "npm test -w server",
    "migrate": "node server/scripts/migrate-json.js"
  }
}
