# Copy this file to .env and fill it in.  cp .env.example .env
# .env is gitignored — your real key never gets committed.
# Real environment variables override anything set here.

# Your Mesh Router Service Key. With this set, the key stays on the server
# and the browser never sees it — leave the key field in Settings empty.
MESH_API_KEY=rsk_your_key_here

# Port for the local server (default 8787)
# PORT=8787

# --- History storage (all optional) ---
# Without MONGODB_URI, history is written to ./council-data.json instead.
# Requires: npm install mongodb
# MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=llm_council
# MONGODB_RUNS=runs
# MONGODB_SETTINGS=settings

# Where the file-based history store writes (default ./council-data.json)
# COUNCIL_DB_FILE=./council-data.json

# Upstream gateway. Only change this if you are pointing at a Mesh-compatible mock.
# MESH_BASE_URL=https://api.meshapi.ai
