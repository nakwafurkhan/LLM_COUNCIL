# ===========================================================================
#  Mesh API — the only required setting
#  Get a key at https://meshapi.ai (it looks like rsk_...)
# ===========================================================================
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# ===========================================================================
#  Models — one per mode. Change these, not the code.
#  Open the model picker in the UI to see what your account actually has.
# ===========================================================================
# Chat — a straight conversation
CHAT_MODEL=anthropic/claude-sonnet-4.5

# Quick — same code path as Chat, but cheap and capped short
QUICK_MODEL=openai/gpt-4o-mini

# Humanize — rewrites stiff, AI-sounding text
HUMANIZER_MODEL=anthropic/claude-sonnet-4.5

# Council — comma-separated members, plus the chairman who synthesises.
# A run costs about (2 x members) + 1 completions, so 3 members is the sane default.
COUNCIL_MODELS=openai/gpt-4o,anthropic/claude-sonnet-4.5,google/gemini-2.5-pro
CHAIRMAN_MODEL=anthropic/claude-sonnet-4.5

# Stand-in used when a council member errors or times out.
FALLBACK_MODEL=openai/gpt-4o-mini

# ===========================================================================
#  Spend guards
# ===========================================================================
MAX_TOKENS_CHAT=2000
MAX_TOKENS_QUICK=400
MAX_TOKENS_HUMANIZE=2000
MAX_TOKENS_STAGE1=1200
MAX_TOKENS_STAGE2=800
MAX_TOKENS_STAGE3=2000
MAX_TOKENS_CODE=4000

TEMPERATURE=0.7
REQUEST_TIMEOUT_S=120
MAX_RETRIES=2

# ===========================================================================
#  Code + PR mode (optional) — token needs `repo` scope
# ===========================================================================
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# ===========================================================================
#  Server
# ===========================================================================
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
