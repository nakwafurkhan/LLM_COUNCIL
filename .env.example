# Copy to .env and fill in.   cp .env.example .env
# .env is gitignored. Real environment variables override anything set here.
#
# Every variable the server reads is listed below and validated at boot by
# server/src/config/env.js. A missing or malformed required value fails the
# process immediately with the offending name — it never surfaces as a 500.

# ============================================================
# Required
# ============================================================

# Your Mesh Router Service Key. Stays on the server; the browser never sees it.
# NOTE: the pre-2.0 server.js read MESHAPI_KEY (no underscore). That name is
# gone — MESH_API_KEY is the only spelling now.
MESH_API_KEY=rsk_your_key_here

# MongoDB connection string. Atlas or a local mongod both work.
# docker-compose users: mongodb://mongo:27017
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ============================================================
# Core (optional — defaults shown)
# ============================================================

# PORT=8787
# NODE_ENV=development                  # development | test | production
# MONGODB_DB=llm_council
# LOG_LEVEL=info                        # fatal|error|warn|info|debug|trace|silent
# Origins allowed to call the API. Only matters in dev, when Vite is on another port.
# CORS_ORIGINS=http://localhost:5173
# BODY_LIMIT=1mb

# ============================================================
# Upstream provider
# ============================================================

# MESH_BASE_URL=https://api.meshapi.ai/v1
# MESH_TIMEOUT_MS=120000
# MESH_MAX_RETRIES=2                    # retries on 429/5xx only, with backoff

# ============================================================
# Models
# ============================================================
# A client may only request a model that appears somewhere in this section.
# Raw client-supplied model strings are rejected with a 400.

# CHAT_MODEL=openai/gpt-4o
# QUICK_MODEL=openai/gpt-4o-mini
# COUNCIL_MODELS=openai/gpt-4o,openai/gpt-4o-mini,anthropic/claude-3-5-sonnet
# CHAIRMAN_MODEL=openai/gpt-4o
# CODE_MODEL=openai/gpt-4o
# HUMANIZER_MODEL=openai/gpt-4o
# Extra ids to accept beyond those above, comma-separated.
# EXTRA_ALLOWED_MODELS=

# ============================================================
# Chat and Quick tuning
# ============================================================
# Quick mode is the same code path as Chat with cheaper parameters.

# CHAT_MAX_TOKENS=4096
# QUICK_MAX_TOKENS=1024
# QUICK_TIMEOUT_MS=30000
# CHAT_CONTEXT_WINDOW=20                # recent messages sent verbatim
# CHAT_SUMMARY_TRIGGER=30               # summarise once a thread exceeds this

# ============================================================
# Humanizer
# ============================================================
# Three model passes per run (draft, self-audit, revision), so this is the
# second most expensive mode after Council.

# HUMANIZER_MAX_TOKENS=8192

# ============================================================
# Council
# ============================================================

# COUNCIL_MEMBER_TIMEOUT_MS=60000       # one slow model can't stall the run
# COUNCIL_MAX_CONCURRENCY=3
# COUNCIL_CACHE_TTL_MS=600000           # 0 disables the prompt-hash cache

# ============================================================
# Code + PR
# ============================================================
# Required only if you use Code+PR mode. /api/health reports whether these
# are configured (as booleans — never values).

# Absolute path to a local clone the job may branch from. Jobs run in a
# dedicated git worktree; your checked-out branch is never touched.
# REPO_LOCAL_PATH=/absolute/path/to/your/repo

# Needs `repo` scope. Never written to .git/config or any log line.
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_OWNER=your-username
# GITHUB_REPO=your-repo
# BASE_BRANCH=main

# PR_MAX_FILES=20
# Auto-detected from the target repo's package.json when unset.
# PR_LINT_CMD=npm run lint
# PR_TEST_CMD=npm test
# PR_VERIFY_TIMEOUT_MS=300000
# PR_MAX_REPAIR_ATTEMPTS=2              # repair rounds after a failed verify
# PR_AUTO_APPROVE=false                 # skip the human diff gate. CI only.
# PR_CONTEXT_TOKEN_BUDGET=60000

# ============================================================
# Rate limiting (per IP)
# ============================================================

# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# RATE_LIMIT_COUNCIL_MAX=10
# RATE_LIMIT_PR_MAX=5

# ============================================================
# Testing
# ============================================================
# Swaps in the scriptable fake LLM adapter. Used by the test suite and E2E.
# Never enable in production.
# USE_FAKE_LLM=false
